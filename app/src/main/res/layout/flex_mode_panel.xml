<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/flexModePanel"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_gravity="bottom"
    android:visibility="gone"
    android:background="#E6000000">

    <!-- Mode 1: Touchpad-only (default) -->
    <LinearLayout
        android:id="@+id/flexTouchpadOnlyGroup"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Touchpad area - takes all available space -->
        <View
            android:id="@+id/flexTouchpadArea"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="#1AFFFFFF" />

        <!-- Separator line -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#33FFFFFF" />

        <!-- Button bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="8dp"
            android:paddingEnd="8dp">

            <TextView
                android:id="@+id/flexBtnLeftClick"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:gravity="center"
                android:text="@string/flex_left_click"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:background="@drawable/flex_panel_button_bg"
                android:clickable="true"
                android:focusable="true" />

            <ImageButton
                android:id="@+id/flexBtnKeyboard"
                android:layout_width="56dp"
                android:layout_height="44dp"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:src="@drawable/ic_fullscreen_keyboard"
                android:background="@drawable/flex_panel_button_bg"
                android:scaleType="centerInside"
                android:padding="8dp"
                android:contentDescription="@string/flex_keyboard"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/flexBtnRightClick"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:gravity="center"
                android:text="@string/flex_right_click"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:background="@drawable/flex_panel_button_bg"
                android:clickable="true"
                android:focusable="true" />

        </LinearLayout>

    </LinearLayout>

    <!-- Mode 2: Keyboard + Touchpad split -->
    <LinearLayout
        android:id="@+id/flexKeyboardTouchpadGroup"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="gone">

        <!-- Keyboard container - fills all remaining space -->
        <FrameLayout
            android:id="@+id/flexKeyboardContainer"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Separator -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#33FFFFFF" />

        <!-- Bottom: compact touchpad strip with mouse buttons (fixed height) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:orientation="horizontal">

            <!-- Left click -->
            <TextView
                android:id="@+id/flexKbBtnLeftClick"
                android:layout_width="48dp"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="L"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold"
                android:background="@drawable/flex_panel_button_bg"
                android:clickable="true"
                android:focusable="true" />

            <!-- Separator -->
            <View
                android:layout_width="1dp"
                android:layout_height="match_parent"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp"
                android:background="#33FFFFFF" />

            <!-- Mini touchpad -->
            <View
                android:id="@+id/flexKbTouchpadArea"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="#0DFFFFFF" />

            <!-- Separator -->
            <View
                android:layout_width="1dp"
                android:layout_height="match_parent"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp"
                android:background="#33FFFFFF" />

            <!-- Right click -->
            <TextView
                android:id="@+id/flexKbBtnRightClick"
                android:layout_width="48dp"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="R"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold"
                android:background="@drawable/flex_panel_button_bg"
                android:clickable="true"
                android:focusable="true" />

        </LinearLayout>

    </LinearLayout>

    <!-- Small touchpad icon hint (visible only in touchpad-only mode) -->
    <ImageView
        android:id="@+id/flexTouchpadHint"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="center"
        android:src="@drawable/ic_mouse_move"
        android:alpha="0.15" />

</FrameLayout>
